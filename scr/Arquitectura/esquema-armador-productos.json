{
  "nombre": "Armador de Productos - Costos y Recetas",
  "origen": "Google Sheets",
  "version": "1.1",
  "descripcion": "Esquema relacional para Sheets / futura migración PostgreSQL. Incluye fórmulas, sumatorias, campos reflejo, generación de IDs, orden autogenerado, listas de valores, precisión decimal y navegación (menú y flujo). Origen: migración desde otra BD.",

  "generacionId": {
    "descripcion": "Reglas para crear PKs únicos; provienen de migración desde otra BD.",
    "separador": "-",
    "formatos": [
      {
        "id": "formato-prefijo-alfanumerico",
        "descripcion": "Prefijo fijo + cadena alfanumérica única.",
        "patron": "{prefijo}-{alfanumerico}",
        "ejemplo": "PROD-COSTO-54asf34aa13a",
        "generacion": {
          "prefijo": "valor fijo por tabla",
          "alfanumerico": "longitud variable, caracteres [0-9a-z] únicos por registro"
        },
        "aplicadoA": [
          { "tabla": "Tabla-Costo-Productos", "pk": "IDCosto-Producto", "prefijo": "PROD-COSTO" },
          { "tabla": "Tabla-Costos-ProductoUnitario", "pk": "IDCosto-ProductoUnitario", "prefijo": "CPU" },
          { "tabla": "Tabla-Elaboracion-ProductosBase", "pk": "IDElaboracion-ProductoBase", "prefijo": "ELAB" },
          { "tabla": "Tabla-Receta-Base", "pk": "IDReceta-Base", "prefijo": "REC" },
          { "tabla": "Tabla-Receta-Base-Detalle", "pk": "IDReceta-Base-Detalle", "prefijo": "RBD" },
          { "tabla": "Tabla-Receta-Relleno-Detalle", "pk": "IDReceta-Relleno", "prefijo": "RR" },
          { "tabla": "Tabla-Receta-Decoracion-Detalle", "pk": "IDReceta-Decoracion", "prefijo": "RD" },
          { "tabla": "Tabla-Packing", "pk": "IDPacking", "prefijo": "PKG" },
          { "tabla": "Tabla-Packing-Detalle", "pk": "IDPacking-Detalle", "prefijo": "PD" },
          { "tabla": "Tabla-Insumo-Materia-Prima", "pk": "IDInsumo-MateriaPrima", "prefijo": "IMP" },
          { "tabla": "Tabla-Insumo-Packing", "pk": "IDInsumo-Packing", "prefijo": "IP" },
          { "tabla": "Listado-Productos-Elaborados", "pk": "IDProducto", "prefijo": "PROD" }
        ]
      },
      {
        "id": "formato-id-alfanumerico-sufijo-numerico",
        "descripcion": "ID + alfanumérico + guión + 4 dígitos numéricos aleatorios.",
        "patron": "ID-{alfanumerico}-{4digitos}",
        "ejemplo": "ID-zd1h654dhz4d4lh-6712",
        "generacion": {
          "prefijoFijo": "ID",
          "alfanumerico": "cadena única",
          "sufijoNumerico": "4 dígitos aleatorios (0-9)"
        },
        "aplicadoA": [
          { "tabla": "Tabla-Costo-Productos-Compuesto-ProductoBase", "pk": "ID-Unico" },
          { "tabla": "Tabla-Packing-Productos", "pk": "ID-Unico" }
        ]
      }
    ]
  },

  "ordenAutogenerado": {
    "descripcion": "Columnas Orden que se generan incrementalmente: último valor + 1 (1, 2, 3, ...).",
